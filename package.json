{
  "name": "panel-de-pruebas",
  "version": "1.2.0",
  "description": "Hub central de pruebas para proyectos web con acceso directo por sistema, rol y credenciales.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js --abrir",
    "dev": "node --watch server.js",
    "test": "node --test tests/qa.test.js tests/inicio-sesion.test.js",
    "audit": "node scripts/auditoria-seguridad.js",
    "load-test": "node scripts/prueba-carga.js",
    "ficha-tecnica": "node scripts/detector-ficha-tecnica.js",
    "build:css": "npx --yes tailwindcss@3.4.17 -c tools/tailwind.config.js -i tools/tailwind.input.css -o public/css/tailwind.css --minify"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Francisco Javier Córdova Altamirano",
  "private": true,
  "dependencies": {
    "playwright-core": "1.55.1"
  }
}
